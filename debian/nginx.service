# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=nginx network and static services
After=network-online.target session-ticket-keys-create.service diamaneos-egress.service
Wants=network-online.target
Requires=session-ticket-keys-create.service diamaneos-egress.service

[Service]
Type=forking
User=www-data
Group=www-data
SupplementaryGroups=diamaneos-tls tls
PIDFile=/run/nginx/nginx.pid
RuntimeDirectory=nginx
RuntimeDirectoryMode=0750
CacheDirectory=nginx
StateDirectory=nginx
ExecStartPre=/usr/sbin/nginx -e stderr -t -q
ExecStart=/usr/sbin/nginx -e stderr
ExecReload=/usr/sbin/nginx -e stderr -t -q
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -QUIT $MAINPID
TimeoutStopSec=90
KillMode=mixed
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@keyring @privileged
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
InaccessiblePaths=-/etc/letsencrypt/accounts -/etc/ssh -/etc/wireguard -/etc/diamaneos
InaccessiblePaths=-/run/dbus/system_bus_socket -/run/systemd/private -/run/systemd/io.systemd.Credentials -/run/systemd/io.systemd.Hostname -/run/systemd/io.systemd.ManagedOOM -/run/systemd/io.systemd.sysext
InaccessiblePaths=-/run/systemd/resolve/io.systemd.Resolve -/run/systemd/resolve/io.systemd.Resolve.Monitor -/run/nscd/socket -/run/systemd/netif -/run/systemd/userdb -/run/systemd/journal -/run/systemd/ask-password -/run/udev/control -/run/ssh-unix-local
LimitCORE=0
MemoryMax=1G
TasksMax=256
LimitNOFILE=32768
UMask=0027
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
