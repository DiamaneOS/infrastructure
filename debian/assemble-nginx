#!/usr/bin/python3
# SPDX-License-Identifier: Apache-2.0
"""Assemble service vhosts and local includes into a new configuration directory."""
from pathlib import Path
import fnmatch
import glob
import ipaddress
import json
import re
import sys

USAGE = ('usage: assemble-nginx primary|mirror|attestation SOURCE_ROOT OUTPUT [--before-status-certificate]'
         ' [--host-json PATH] [--download-address ADDRESS]... [--downloads-moved]')
DOWNLOAD_NAMES = {'releases.diamaneos.de', 'apps.diamaneos.de'}
HOST_JSON = '/etc/diamaneos/host.json'
if len(sys.argv) < 4:
    raise SystemExit(USAGE)
role, source, output = sys.argv[1], Path(sys.argv[2]), Path(sys.argv[3])
options = sys.argv[4:]
# nginx refuses to start without a certificate, so the first status certificate
# is requested while only the status page's HTTP server is live.
pending = '--before-status-certificate' in options
# The primary's download names can have their own addresses (host.json download_addresses).
# Moved: they no longer answer on the shared address of that family, once DNS points at theirs
# (host.json downloads_moved). The options give the same settings without host.json.
moved = '--downloads-moved' in options
downloads = {}
host_json = None
rest = [option for option in options if option not in ('--before-status-certificate', '--downloads-moved')]


def add_download(value, found):
    try:
        address = ipaddress.ip_address(value)
    except ValueError:
        raise SystemExit('invalid download address') from None
    if (address.version in found or address.is_loopback or address.is_link_local
            or address.is_multicast or address.is_unspecified):
        raise SystemExit('download addresses: one unicast IPv4 and at most one IPv6 address')
    found[address.version] = address


while rest[:1] in (['--download-address'], ['--host-json']) and len(rest) > 1:
    if rest[0] == '--download-address':
        add_download(rest[1], downloads)
    elif host_json is None:
        host_json = rest[1]
    else:
        raise SystemExit(USAGE)
    del rest[:2]
if (rest or (pending and role != 'mirror') or ((downloads or moved or host_json) and role != 'primary')
        or (moved and not downloads)):
    raise SystemExit(USAGE)
if role not in {'primary', 'mirror', 'attestation'}:
    raise SystemExit('invalid role')


def host_downloads(path, explicit):
    """The download settings of host.json, None without the file or the field."""
    try:
        config = json.loads(Path(path).read_text())
    except FileNotFoundError:
        if explicit:
            raise SystemExit('host configuration not found: ' + path) from None
        return None
    except OSError:
        raise SystemExit(f'cannot read {path}: run as root or pass --host-json') from None
    except ValueError:
        raise SystemExit(f'invalid host configuration: {path}') from None
    if not isinstance(config, dict):
        raise SystemExit(f'invalid host configuration: {path}')
    values, found = config.get('download_addresses'), {}
    host_moved = config.get('downloads_moved', False)
    if type(host_moved) is not bool:
        raise SystemExit('downloads_moved must be a boolean')
    if 'download_addresses' not in config:
        if host_moved:
            raise SystemExit('downloads_moved needs download_addresses')
        return None
    if not isinstance(values, list) or not all(isinstance(value, str) for value in values):
        raise SystemExit('download_addresses must be a list of addresses')
    for value in values:
        add_download(value, found)
    if host_moved and not found:
        raise SystemExit('downloads_moved needs download_addresses')
    return found, host_moved


if role == 'primary':
    settings = host_downloads(host_json or HOST_JSON, host_json is not None)
    if settings is not None:
        if (downloads or moved) and (downloads, moved) != settings:
            raise SystemExit('the download options differ from host.json')
        downloads, moved = settings


def listen(address, port):
    return f'[{address}]:{port}' if address.version == 6 else f'{address}:{port}'


def download_vhosts(text):
    """Add the download addresses to the download servers' wildcard listens, or replace them if moved."""
    changed = set()

    def replace(match):
        address = downloads.get(6 if match[2] else 4)
        if address is None:
            return match[0]
        changed.add(address.version)
        line = f'{match[1]}listen {listen(address, match[3])}{match[4] or ""};'
        return line if moved else match[0] + '\n' + line

    blocks = re.split(r'(?m)^(?=server \{)', text)
    for index, block in enumerate(blocks):
        names = re.search(r'\bserver_name\s+([^;]+);', block)
        if names and set(names[1].split()) <= DOWNLOAD_NAMES:
            blocks[index] = re.sub(r'(?m)^(\s*)listen (\[::\]:)?(80|443)( ssl)?;$', replace, block)
    if changed != set(downloads):
        raise SystemExit('download servers have no wildcard listen for each download address')
    # Any other name on these addresses gets its connection closed.
    defaults = ''.join(f'server {{\n    listen {listen(address, 80)} default_server;\n    return 444;\n}}\n\n'
                       f'server {{\n    listen {listen(address, 443)} default_server ssl;\n'
                       '    ssl_reject_handshake on;\n}\n\n' for address in downloads.values())
    return '# Only the download names answer on the download addresses.\n' + defaults + ''.join(blocks)


def download_supl(text):
    """The download addresses close SUPL connections instead of relaying them."""
    before, separator, after = text.partition('\nstream {')
    if not separator or not after.endswith('\n}\n'):
        raise SystemExit('stream block not found')
    servers = ''.join(f'\n    server {{\n        listen {listen(address, 7275)};\n        return "";\n    }}\n'
                      for address in downloads.values())
    return before + separator + after[:-2] + '\n    # No SUPL relay on the download addresses.' + servers + '}\n'


if output.exists():
    raise SystemExit('output must be a new directory')
files = {}
roots = ['network', 'releases'] if role == 'primary' else ['releases' if role == 'mirror' else 'attestation']
for root in roots:
    for path in (source / root / 'nginx').iterdir():
        if path.is_file() and not path.is_symlink():
            files[path.name] = path.read_text()
if role == 'primary':
    files['nginx.conf'] = (source / 'network/nginx/nginx.conf').read_text()
    files['nginx.conf'] = files['nginx.conf'].replace(
        'include releases[.]conf;', 'include releases[.]conf;\n    include website[.]conf;')
    if downloads:
        files['releases.conf'] = download_vhosts(files['releases.conf'])
        files['nginx.conf'] = download_supl(files['nginx.conf'])
if role == 'mirror':
    # Reuse the artifact handlers on fixed regional names. Each host answers
    # its own ACME challenges; client fallback does not change shared DNS.
    files['nginx.conf'] = files['nginx.conf'].replace(
        'include releases.conf;', 'include releases.conf;\n    include mirror.conf;')
    files['mirror.conf'] = '''server {
    listen 80;
    listen [::]:80;
    server_name mirror.diamaneos.de;
    location /.well-known/acme-challenge/ { root /var/lib/letsencrypt/webroot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name mirror.diamaneos.de;
    ssl_certificate /etc/letsencrypt/live/diamaneos-mirror/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/diamaneos-mirror/privkey.pem;
    location = /healthz { default_type text/plain; return 200 "ready\\n"; }
    # The time of the monitor's last completed run, which the primary checks.
    location = /monitor-heartbeat { default_type text/plain; disable_symlinks on; alias /var/lib/diamaneos-status-page/heartbeat; }
    location / { return 404; }
}
'''
for name, text in files.items():
    if not name.endswith('.conf'):
        continue
    if role == 'mirror':
        names = {'releases.diamaneos.de': 'releases-na.diamaneos.de',
                 'apps.diamaneos.de': 'apps-na.diamaneos.de'}
        text = re.sub(r'(\bserver_name\s+)([^;]+);', lambda match:
            match[1] + ' '.join(names.get(name, name)
                               for name in match[2].split()) + ';', text)
        text = text.replace('/etc/letsencrypt/live/diamaneos-artifacts/', '/etc/letsencrypt/live/diamaneos-mirror-artifacts/').replace('/etc/letsencrypt/live/diamaneos-primary/', '/etc/letsencrypt/live/diamaneos-mirror/')
    # Advertising-industry opt-out has the same response on each public host.
    before, separator, after = text.partition('\nstream {')
    before = re.sub(r'(\n\s*server_name [^;]+;)', r'\1\n        include ads.conf;', before)
    files[name] = before + separator + after
if role == 'mirror':
    # The unlisted status page serves only its page and robots.txt, without ads.conf.
    files['mirror.conf'] += '''server {
    listen 80;
    listen [::]:80;
    server_name status.diamaneos.de;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    location /.well-known/acme-challenge/ { root /var/lib/letsencrypt/webroot; }
    location / { return 301 https://$host$request_uri; }
}
'''
    if not pending:
        files['mirror.conf'] += '''server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name status.diamaneos.de;
    ssl_certificate /etc/letsencrypt/live/diamaneos-status/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/diamaneos-status/privkey.pem;
    root /var/lib/diamaneos-status-page;
    disable_symlinks on from=$document_root;
    # Locations add no headers, so these apply to every response.
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Cache-Control "no-cache" always;
    add_header Content-Security-Policy "default-src 'none'; style-src 'sha256-7yC9xC/iI2tfRx8ChmbZOZ2Q+6s4bRpnah8Zp3SnLgc='; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    location = / { try_files /index.html =404; }
    location = /robots.txt { default_type text/plain; return 200 "User-agent: *\\nDisallow: /\\n"; }
    location / { return 404; }
}
'''
files['ads.conf'] = '''location = /ads.txt {
    default_type text/plain;
    return 200 "placeholder.example.com, placeholder, DIRECT, placeholder\\n";
}
location = /app-ads.txt {
    default_type text/plain;
    return 200 "placeholder.example.com, placeholder, DIRECT, placeholder\\n";
}
'''

# Follow local include dependencies from the active entry point.
used = set()
remaining = ['nginx.conf']
while remaining:
    name = remaining.pop()
    if name in used:
        continue
    if name not in files:
        raise SystemExit('Referenced nginx file is missing: ' + name)
    used.add(name)
    for match in re.finditer(r'(?m)^\s*include\s+([^;]+);', files[name]):
        pattern = match[1].strip()
        if (pattern.startswith(('"', "'")) and pattern[-1:] == pattern[:1]):
            pattern = pattern[1:-1]
        if not re.fullmatch(r'[A-Za-z0-9_.?*\[\]-]+', pattern):
            raise SystemExit('Only local nginx include names are supported')
        matches = sorted(name for name in files if fnmatch.fnmatchcase(name, pattern))
        if not matches and not glob.has_magic(pattern):
            raise SystemExit('Referenced nginx file is missing: ' + pattern)
        remaining.extend(matches)

output.mkdir(mode=0o755)
for name in sorted(used):
    (output / name).write_text(files[name])
