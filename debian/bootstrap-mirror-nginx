#!/usr/bin/python3
# SPDX-License-Identifier: Apache-2.0
"""Print an ACME-only first-start config before canonical certificates exist."""
print('''pid /run/nginx/nginx.pid;
error_log stderr crit;
events { worker_connections 128; }
http {
    access_log off;
    server_tokens off;
    client_max_body_size 1k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    ssl_protocols TLSv1.3;
    ssl_session_tickets off;
    ssl_certificate /etc/letsencrypt/live/diamaneos-mirror/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/diamaneos-mirror/privkey.pem;
    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        location / { return 421; }
    }
    server {
        listen 80;
        listen [::]:80;
        server_name mirror.diamaneos.de releases-na.diamaneos.de apps-na.diamaneos.de;
        location /.well-known/acme-challenge/ { root /var/lib/letsencrypt/webroot; }
        location / { return 404; }
    }
    server {
        listen 443 ssl default_server;
        listen [::]:443 ssl default_server;
        ssl_reject_handshake on;
    }
    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        server_name mirror.diamaneos.de;
        location /.well-known/acme-challenge/ { root /var/lib/letsencrypt/webroot; }
        location = /healthz { default_type text/plain; return 200 "ready\\n"; }
        location / { return 404; }
    }
}
''')
