"""Enforce volatile service logging without removing existing log files."""
import os
from pathlib import Path
import re
import resource
import stat
import subprocess
import sys
import tempfile


SYSLOG_UNITS = ('syslog.socket', 'rsyslog.service', 'syslog.service', 'syslog-ng.service')
MASK_UNITS = SYSLOG_UNITS + ('syslog-ng@.service',)
EXPECTED = {'Storage': 'volatile', 'RuntimeMaxUse': '160M',
            'MaxRetentionSec': '1day', 'ForwardToSyslog': 'no'}
MAX_OUTPUT = 65536
ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C', 'LC_ALL': 'C'}


def require(condition):
    if not condition:
        raise RuntimeError('host logging policy failed')


def command(argv, accepted=(0,)):
    def limits():
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        resource.setrlimit(resource.RLIMIT_FSIZE, (MAX_OUTPUT, MAX_OUTPUT))
    with tempfile.TemporaryFile() as output:
        result = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=output,
            stderr=subprocess.DEVNULL, env=ENV, timeout=30, preexec_fn=limits)
        output.seek(0); body = output.read(MAX_OUTPUT)
        require(result.returncode in accepted and len(body) < MAX_OUTPUT)
    return result.returncode, body.decode('utf-8')


def journal_settings(text):
    """Parse one verified file, using only unquoted single-line scalar settings."""
    require(type(text) is str and text.isascii() and len(text) < MAX_OUTPUT
            and all(ord(char) >= 32 or char in '\t\r\n' for char in text))
    lines = text.split('\n')
    require(len(lines) <= 4096)
    values, section = {}, None
    for raw in lines:
        require(len(raw) <= 4096)
        if raw.endswith('\r'):
            raw = raw[:-1]
        require('\r' not in raw)
        # A source comment could impersonate cat-config's file banner. Refuse
        # it, rather than letting concatenated output choose section lifetime.
        require(not raw.startswith('# /'))
        row = raw.strip(' \t')
        if not row or row.startswith(('#', ';')):
            continue
        require('\\' not in row)
        if row.startswith('['):
            require(re.fullmatch(r'\[[A-Za-z][A-Za-z0-9_.-]*\]', row))
            section = row[1:-1]
        else:
            require(section is not None and '=' in row)
            key, value = (part.strip(' \t') for part in row.split('=', 1))
            require(re.fullmatch(r'[A-Za-z][A-Za-z0-9]*', key)
                    and re.fullmatch(r'[A-Za-z0-9_.:/@%+-]*', value))
            if section == 'Journal' and key in EXPECTED:
                values[key] = value
    return values


def check_journal_policy(text):
    require(journal_settings(text) == EXPECTED)


def journal_files(root, owner):
    prefixes = ('etc/systemd', 'run/systemd', 'usr/local/lib/systemd', 'usr/lib/systemd')
    main, dropins = None, {}
    for prefix in prefixes:
        directory = root / prefix
        for candidate in (directory / 'journald.conf', directory / 'journald.conf.d'):
            for parent in (root, *candidate.relative_to(root).parents):
                path = parent if parent == root else root / parent
                if not path.exists() and not path.is_symlink():
                    continue
                info = path.lstat()
                require(stat.S_ISDIR(info.st_mode) and info.st_uid == owner and not info.st_mode & 0o022)
        path = directory / 'journald.conf'
        if path.exists() or path.is_symlink():
            require(not path.is_symlink())
            if main is None: main = path
        directory = directory / 'journald.conf.d'
        if directory.exists() or directory.is_symlink():
            info = directory.lstat()
            require(stat.S_ISDIR(info.st_mode) and info.st_uid == owner and not info.st_mode & 0o022)
            for count, path in enumerate(directory.iterdir(), 1):
                require(count <= 128)
                if not path.name.endswith('.conf'): continue
                require(re.fullmatch(r'[A-Za-z0-9_.@:+-]+[.]conf', path.name) and not path.is_symlink())
                dropins.setdefault(path.name, path)
                require(len(dropins) <= 128)
    paths = ([main] if main is not None else []) + [dropins[name] for name in sorted(dropins)]
    require(paths and len(paths) <= 128)
    return paths


def journal_file(path, owner):
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, 'rb') as stream:
        info = os.fstat(stream.fileno())
        require(stat.S_ISREG(info.st_mode) and info.st_uid == owner and info.st_nlink == 1
                and not info.st_mode & 0o022 and info.st_size < MAX_OUTPUT)
        body = stream.read(MAX_OUTPUT)
        fields = ('st_dev','st_ino','st_mode','st_uid','st_gid','st_nlink','st_size','st_mtime_ns','st_ctime_ns')
        identity = tuple(getattr(info, field) for field in fields)
        require(len(body) == info.st_size and tuple(getattr(path.lstat(), field) for field in fields) == identity)
    return identity, body.decode('utf-8')


def check_journal_configuration(root=Path('/'), owner=0):
    """Match native output to independently verified files. Never trust banners."""
    require(root.is_absolute() and not root.is_symlink())
    paths = journal_files(root, owner)
    snapshots = {path: journal_file(path, owner) for path in paths}
    require(sum(len(body.encode()) for _, body in snapshots.values()) < MAX_OUTPUT)
    values = {}
    for _, body in snapshots.values(): values.update(journal_settings(body))
    argv = ['/usr/bin/systemd-analyze']
    if root != Path('/'): argv.append('--root=' + str(root))
    _, text = command([*argv, 'cat-config', 'systemd/journald.conf'])
    sections, current = {}, None
    for row in text.split('\n'):
        if row.startswith('# /'):
            current = Path(row[2:])
            require(current in snapshots and current not in sections)
            sections[current] = []
        elif current is not None:
            sections[current].append(row)
        else:
            require(not row)
    require(list(sections) == paths)
    for path in paths:
        require('\n'.join(sections[path]).rstrip('\n') == snapshots[path][1].rstrip('\n'))
        require(journal_file(path, owner) == snapshots[path])
    require(journal_files(root, owner) == paths and values == EXPECTED)


def unit_facts(unit):
    _, text = command(['/usr/bin/systemctl', 'show', unit,
                       '-p', 'LoadState', '-p', 'ActiveState', '-p', 'Job'])
    pairs = [row.split('=', 1) for row in text.splitlines()]
    require(len(pairs) == 3 and all(len(pair) == 2 for pair in pairs)
            and {pair[0] for pair in pairs} == {'LoadState', 'ActiveState', 'Job'})
    return dict(pairs)


def quiescent(facts):
    return facts['ActiveState'] == 'inactive' and facts['Job'] in ('', '0')


def syslog_instances():
    instances = set()
    # An explicit instance unit can override a masked template. Include both
    # loaded instances and unit files that could be activated on the next boot.
    for action in ('list-units', 'list-unit-files'):
        # An empty list-unit-files glob exits 1, as do real read failures. Use
        # the Debian syslog socket as a positive anchor. Never accept exit 1.
        patterns = ['syslog-ng@*.service'] + (['syslog.socket'] if action == 'list-unit-files' else [])
        _, text = command(['/usr/bin/systemctl', action, '--all', '--plain', '--full',
                           '--no-legend', '--no-pager', *patterns])
        rows = text.splitlines()
        require(len(rows) <= 34)
        anchor = False
        for row in rows:
            fields = row.split()
            require(len(fields) >= (4 if action == 'list-units' else 2))
            unit = fields[0]
            if action == 'list-unit-files' and unit == 'syslog.socket':
                anchor = True
                continue
            require(unit.startswith('syslog-ng@') and unit.endswith('.service')
                    and len(unit) <= 255 and '/' not in unit)
            if unit != 'syslog-ng@.service':
                instances.add(unit)
        require(action != 'list-unit-files' or anchor)
    require(len(instances) <= 32)
    return tuple(sorted(instances))


def configure_logging():
    require(os.geteuid() == 0)
    check_journal_configuration()
    instances = syslog_instances()
    receivers, masks = SYSLOG_UNITS + instances, MASK_UNITS + instances
    # Mask first so a socket or journal reader cannot reactivate during stops.
    # --force replaces a syslog.service alias. An existing regular unit refuses.
    command(['/usr/bin/systemctl', 'mask', '--force', *masks])
    command(['/usr/bin/systemctl', 'daemon-reload'])
    for unit in receivers:
        facts = unit_facts(unit)
        require(facts['LoadState'] in ('loaded', 'masked', 'not-found'))
        if not quiescent(facts):
            command(['/usr/bin/systemctl', 'stop', unit])
    for unit in masks:
        _, state = command(['/usr/bin/systemctl', 'is-enabled', unit], accepted=(0, 1))
        require(state.strip() == 'masked')
        if unit in receivers:
            facts = unit_facts(unit)
            require(facts['LoadState'] == 'masked' and quiescent(facts))
    # Also refuse conventional syslog daemons running outside these units.
    status, text = command(['/usr/bin/pgrep', '-x', 'rsyslogd|syslog-ng|syslogd'], accepted=(0, 1))
    require(status == 1 and not text.strip())


if __name__ == '__main__':
    try:
        configure_logging()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
        print('host logging policy failed', file=sys.stderr)
        raise SystemExit(1)
